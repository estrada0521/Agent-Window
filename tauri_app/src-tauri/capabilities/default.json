{
  "identifier": "default",
  "description": "Default capabilities for Agent Window",
  "remote": {
    "urls": [
      "http://127.0.0.1:*",
      "http://localhost:*",
      "https://127.0.0.1:*",
      "https://localhost:*"
    ]
  },
  "windows": ["main"],
  "permissions": [
    "allow-open-external-url",
    "allow-show-chat-header-menu",
    "allow-show-appearance-menu",
    "allow-reset-window-geometry",
    "allow-compact-window-geometry",
    "allow-set-always-on-top",
    "allow-set-window-height",
    "core:default",
    "core:window:allow-start-dragging"
  ]
}
