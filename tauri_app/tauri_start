#!/usr/bin/env bash

set -euo pipefail

_HERE="${BASH_SOURCE[0]:-$0}"
while [[ -L "$_HERE" ]]; do
  _D="$(cd "$(dirname "$_HERE")" && pwd)"
  _T="$(readlink "$_HERE")"
  [[ "$_T" == /* ]] || _T="$_D/$_T"
  _HERE="$_T"
done
_TAURI_DIR="$(cd "$(dirname "$_HERE")" && pwd)"
ROOT="$(cd "$_TAURI_DIR/.." && pwd)"

usage() {
  cat <<'EOF'
Usage: tauri_app/tauri_start [--dev] [--no-open]

Desktop app entry:
  - builds and opens the local macOS .app by default
  - starts the local Hub over HTTP unless PWA HTTPS has been enabled

Requires python3, tmux, cargo, tauri-cli, and Xcode Command Line Tools; install them yourself before running.

After phone/PWA access is enabled with ./setup/pwa/enable, this command starts HTTPS automatically.

Options:
  --dev         run `cargo tauri dev` instead of building a .app bundle
  --no-open     build and install the app without opening it
  --help        show this help
EOF
}

MODE="build"
OPEN_APP=1

while [[ $# -gt 0 ]]; do
  case "$1" in
    --dev)
      MODE="dev"
      shift
      ;;
    --no-open)
      OPEN_APP=0
      shift
      ;;
    --help|-h)
      usage
      exit 0
      ;;
    *)
      echo "tauri_start: unknown option: $1" >&2
      usage >&2
      exit 1
      ;;
  esac
done

for _hp in /opt/homebrew/bin /usr/local/bin "$HOME/.cargo/bin"; do
  case ":${PATH:-}:" in *:"${_hp}":*) ;; *)
    [[ -d "$_hp" ]] && PATH="${_hp}:$PATH"
    ;;
  esac
done
export PATH

"$ROOT/setup/preflight" --desktop --quiet

export CARGO_TARGET_DIR="${CARGO_TARGET_DIR:-$HOME/.agent-window/cache/tauri-target}"
mkdir -p "$CARGO_TARGET_DIR"

for _cmd in python3 tmux; do
  if ! command -v "$_cmd" >/dev/null 2>&1; then
    echo "tauri_start: $_cmd is required on PATH. Install it, then re-run ./tauri_app/tauri_start." >&2
    exit 1
  fi
done

PWA_ENABLED_FILE="${AGENT_WINDOW_STATE_DIR:-$HOME/.agent-window/state}/pwa/enabled"
if [[ -f "$PWA_ENABLED_FILE" ]]; then
  CERTS_DIR="${AGENT_WINDOW_CERTS_DIR:-$HOME/.agent-window/state/certs}"
  if [[ ! -f "$CERTS_DIR/cert.pem" || ! -f "$CERTS_DIR/key.pem" ]]; then
    echo "tauri_start: local HTTPS certificates are missing." >&2
    echo "tauri_start: start the HTTP app first, then run ./setup/pwa/enable." >&2
    exit 1
  fi
fi

if ! command -v cargo >/dev/null 2>&1; then
  echo "tauri_start: cargo is required for the desktop app." >&2
  echo "tauri_start: install Rust first (https://rustup.rs), then re-run this command." >&2
  exit 1
fi

if ! command -v xcode-select >/dev/null 2>&1 || ! xcode-select -p >/dev/null 2>&1; then
  echo "tauri_start: Xcode Command Line Tools are required." >&2
  echo "tauri_start: run \`xcode-select --install\`, then re-run this command." >&2
  exit 1
fi

if ! cargo tauri --help >/dev/null 2>&1; then
  echo "tauri_start: tauri-cli is required for the desktop app." >&2
  echo "tauri_start: install it with \`cargo install tauri-cli --version \"^2\" --locked\`, then re-run this command." >&2
  exit 1
fi

mkdir -p "$ROOT/assets/sounds"

cd "$_TAURI_DIR/src-tauri"

if [[ "$MODE" == "dev" ]]; then
  exec cargo tauri dev
fi

cargo tauri build --bundles app

bundle_dir="$CARGO_TARGET_DIR/release/bundle/macos"
app_path="$bundle_dir/Agent Window.app"
if [[ ! -d "$app_path" ]]; then
  echo "tauri_start: built app bundle was not found." >&2
  exit 1
fi

installed_app="/Applications/Agent Window.app"
rm -rf "/Applications/Agent Window.app"
rm -rf "/Applications/Multiagent Chat.app"
rm -rf "$HOME/Applications/Agent Window.app"
rm -rf "$HOME/Applications/Multiagent Chat.app"
mv "$app_path" "$installed_app"
find "$bundle_dir" -mindepth 1 -maxdepth 1 -type d -name '*.app' -exec rm -rf {} +

printf 'tauri_start: installed app at %s\n' "$installed_app"
if [[ "$OPEN_APP" == "1" ]]; then
  open "$installed_app"
fi
