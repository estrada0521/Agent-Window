#!/usr/bin/env bash

set -euo pipefail

_REAL_SCRIPT="$(python3 -c 'import os, sys; print(os.path.realpath(sys.argv[1]))' "${BASH_SOURCE[0]:-$0}")"
OPS_DIR="$(cd "$(dirname "$_REAL_SCRIPT")" && pwd)"
REPO_ROOT="$(cd "$OPS_DIR/.." && pwd)"

# shellcheck source=/dev/null
source "$REPO_ROOT/bin/lib/tmux_session.sh"

for _hp in /opt/homebrew/bin /usr/local/bin; do
  case ":${PATH:-}:" in *:"${_hp}":*) ;; *)
    [[ -d "$_hp" ]] && PATH="${_hp}:$PATH"
    ;;
  esac
done
export PATH

for _cmd in python3 tmux; do
  if ! command -v "$_cmd" >/dev/null 2>&1; then
    echo "agent-window: $_cmd is required on PATH. Install it, then re-run this command." >&2
    exit 1
  fi
done

TMUX_SOCKET_NAME="$(resolve_tmux_socket_name)"
SESSION_NAME=""
WORKSPACE="$PWD"
CONTEXT_JSON=0

usage() {
  cat <<'EOF'
Usage: agent-window context [--session NAME] [--workspace PATH] [--json]

Print session/workspace/agent-pane summary for the current pane (or --session).
Session creation and management are done through Hub.
EOF
}

case "${1:-}" in
  -h|--help) usage; exit 0 ;;
  context)   shift ;;
  *)         usage >&2; exit 1 ;;
esac

while [[ $# -gt 0 ]]; do
  case "$1" in
    --session)   SESSION_NAME="$2"; shift 2 ;;
    --workspace) WORKSPACE="$2"; shift 2 ;;
    --json)      CONTEXT_JSON=1; shift ;;
    -h|--help)   usage; exit 0 ;;
    *)           echo "Unknown argument: $1" >&2; usage >&2; exit 1 ;;
  esac
done

WORKSPACE="$(cd "$WORKSPACE" && pwd)"

_context_args=(context --workspace "$WORKSPACE" --tmux-socket "$TMUX_SOCKET_NAME")
[[ -n "$SESSION_NAME" ]] && _context_args+=(--session "$SESSION_NAME")
[[ "$CONTEXT_JSON" -eq 1 ]] && _context_args+=(--json)
session_control "${_context_args[@]}"
