#!/usr/bin/env bash

set -euo pipefail

agent_window_resolve_script_path() {
  local p="${BASH_SOURCE[0]:-$0}"
  while [[ -L "$p" ]]; do
    local d targ
    d="$(cd "$(dirname "$p")" && pwd)"
    targ="$(readlink "$p")"
    if [[ "$targ" == /* ]]; then
      p="$targ"
    else
      p="$d/$targ"
    fi
  done
  printf '%s\n' "$p"
}
_REAL_SCRIPT="$(agent_window_resolve_script_path)"
OPS_DIR="$(cd "$(dirname "$_REAL_SCRIPT")" && pwd)"
REPO_ROOT="$(cd "$OPS_DIR/.." && pwd)"
SCRIPT_DIR="$REPO_ROOT/bin"

for _hp in /opt/homebrew/bin /usr/local/bin; do
  case ":${PATH:-}:" in *:"${_hp}":*) ;; *)
    [[ -d "$_hp" ]] && PATH="${_hp}:$PATH"
    ;;
  esac
done
export PATH

for _cmd in python3 tmux; do
  if ! command -v "$_cmd" >/dev/null 2>&1; then
    echo "agent-window: $_cmd is required on PATH. Install it, then re-run this command." >&2
    exit 1
  fi
done

eval "$(PYTHONPATH="$REPO_ROOT${PYTHONPATH:+:$PYTHONPATH}" python3 -m backend_core.cli.agent_registry_shell)"
APP_NAME="$(basename "$0")"
CENTRAL_LOG_DIR="$(python3 - "$REPO_ROOT" <<'PYEOF'
import sys
from pathlib import Path

repo_root = Path(sys.argv[1]).resolve()
sys.path.insert(0, str(repo_root))
from backend_core.access.settings import local_runtime_log_dir

print(local_runtime_log_dir())
PYEOF
)"
AGENT_WINDOW_RUN_DIR="${AGENT_WINDOW_RUN_DIR:-$(python3 - "$REPO_ROOT" <<'PYEOF'
import sys
from pathlib import Path

repo_root = Path(sys.argv[1]).resolve()
sys.path.insert(0, str(repo_root))
from backend_core.access.settings import agent_window_run_dir

print(agent_window_run_dir())
PYEOF
)}"
export AGENT_WINDOW_RUN_DIR
SESSION_NAME=""
SESSION_NAME_EXPLICIT=0
WORKSPACE="$PWD"
DETACH=0
FRESH=0
AGENTS_ARG=""
NO_AGENTS=0
MODE="up"
LIST_VERBOSE=0
ALL_SESSIONS=0
LATEST_SESSION=0
RENAME_TO=""
CONTEXT_JSON=0
AGENT_WINDOW_WIDTH=66
AGENT_WINDOW_HEIGHT=40

default_tmux_socket_name() {
  python3 - "$REPO_ROOT" <<'PYEOF'
import sys
from pathlib import Path

repo_root = Path(sys.argv[1]).resolve()
sys.path.insert(0, str(repo_root))
from message_delivery.send import default_tmux_socket_name

print(default_tmux_socket_name())
PYEOF
}

TMUX_SOCKET_NAME="${AGENT_WINDOW_TMUX_SOCKET:-$(default_tmux_socket_name)}"
SESSION_TOPOLOGY_LOCK_DIR=""

session_topology_lock_dir() {
  local sock="${1:-$TMUX_SOCKET_NAME}"
  local session_name="${2:-${SESSION_NAME:-${AGENT_WINDOW_SESSION:-default}}}"
  python3 - "$REPO_ROOT" "$sock" "$session_name" <<'PYEOF'
import sys
from pathlib import Path

repo_root = Path(sys.argv[1]).resolve()
sock = sys.argv[2]
session_name = sys.argv[3]
sys.path.insert(0, str(repo_root))
from message_delivery.send import session_topology_lock_path

print(session_topology_lock_path(sock, session_name))
PYEOF
}

release_session_topology_lock() {
  if [[ -n "$SESSION_TOPOLOGY_LOCK_DIR" ]]; then
    python3 - "$REPO_ROOT" "$SESSION_TOPOLOGY_LOCK_DIR" <<'PYEOF'
import sys
from pathlib import Path

repo_root = Path(sys.argv[1]).resolve()
lock_dir = Path(sys.argv[2])
sys.path.insert(0, str(repo_root / "bin"))
from agent_window_lib.state import release_topology_lock

release_topology_lock(lock_dir)
PYEOF
  fi
  SESSION_TOPOLOGY_LOCK_DIR=""
}

acquire_session_topology_lock() {
  local session="$1" lock_dir
  lock_dir="$(session_topology_lock_dir "$TMUX_SOCKET_NAME" "$session")" || {
    echo "Failed to resolve topology lock path: $session" >&2
    return 1
  }
  [[ -n "$lock_dir" ]] || {
    echo "Failed to resolve topology lock path: $session" >&2
    return 1
  }
  if python3 - "$REPO_ROOT" "$lock_dir" "$$" <<'PYEOF'
import sys
from pathlib import Path

repo_root = Path(sys.argv[1]).resolve()
lock_dir = Path(sys.argv[2])
holder_pid = int(sys.argv[3])
sys.path.insert(0, str(repo_root / "bin"))
from agent_window_lib.state import acquire_topology_lock

raise SystemExit(0 if acquire_topology_lock(lock_dir, holder_pid) else 1)
PYEOF
  then
    SESSION_TOPOLOGY_LOCK_DIR="$lock_dir"
    return 0
  fi
  echo "Timed out waiting for topology lock: $session" >&2
  return 1
}

stop_session_chat_server() {
  local session_name="$1"
  python3 - "$REPO_ROOT" "$session_name" <<'PYEOF'
import sys
from pathlib import Path

repo_root = Path(sys.argv[1]).resolve()
session_name = (sys.argv[2] or "").strip()
sys.path.insert(0, str(repo_root / "bin"))
from agent_window_lib.session import stop_session_chat_server

ok, detail = stop_session_chat_server(repo_root, session_name)
if not ok:
    if detail:
        print(detail, file=sys.stderr)
    raise SystemExit(1)
PYEOF
}

cleanup_session_process_groups() {
  local session_name="$1"
  python3 - "$REPO_ROOT" "$session_name" "$TMUX_SOCKET_NAME" <<'PYEOF'
import sys
from pathlib import Path

repo_root = Path(sys.argv[1]).resolve()
session_name = sys.argv[2]
tmux_socket = sys.argv[3]
sys.path.insert(0, str(repo_root))
from backend_core.tmux.process_cleanup import cleanup_target_process_groups
from backend_core.tmux.window import tmux_prefix_args

cleanup_target_process_groups(target=session_name, tmux_prefix=tmux_prefix_args(tmux_socket))
PYEOF
}

agent_in_registry() {
  local candidate="$1" agent
  for agent in "${ALL_AGENTS[@]}"; do
    [[ "$candidate" == "$agent" ]] && return 0
  done
  return 1
}

canonical_agent_name() {
  local candidate="$1"
  case "$candidate" in
    agy|antigravity|antigravity-ide) printf 'gemini\n' ;;
    *) printf '%s\n' "$candidate" ;;
  esac
}

agent_var() {
  local prefix="$1"
  local agent="$2"
  local var_name="${prefix}_${agent}"
  eval "printf '%s' \"\${${var_name}:-}\""
}

resolve_agent_executable() {
  local agent="$1"
  python3 - "$REPO_ROOT" "$agent" <<'PYEOF'
import os
import shutil
import sys
from pathlib import Path

repo_root = Path(sys.argv[1]).resolve()
agent_name = sys.argv[2]

sys.path.insert(0, str(repo_root))
from backend_core.agents.executables import resolve_agent_executable
from backend_core.agents.registry import canonical_agent_name

resolved = resolve_agent_executable(repo_root, agent_name)
if resolved:
    print(resolved)
    raise SystemExit(0)

base = canonical_agent_name(agent_name.split("-", 1)[0])
print(base)
raise SystemExit(1)
PYEOF
}

tmux() {
  case "$TMUX_SOCKET_NAME" in
    /*) command tmux -S "$TMUX_SOCKET_NAME" "$@" ;;
    *) command tmux -L "$TMUX_SOCKET_NAME" "$@" ;;
  esac
}

exec_tmux() {
  case "$TMUX_SOCKET_NAME" in
    /*) exec command tmux -S "$TMUX_SOCKET_NAME" "$@" ;;
    *) exec command tmux -L "$TMUX_SOCKET_NAME" "$@" ;;
  esac
}

default_session_name() {
  basename "$WORKSPACE"
}

ensure_session_agent_doc() {
  local src="$SCRIPT_DIR/../docs/AGENT.md"
  local dest_dir="$WORKSPACE/docs"
  local dest="$dest_dir/AGENT.md"
  [[ -f "$src" ]] || return 0
  mkdir -p "$dest_dir"
  cmp -s "$src" "$dest" 2>/dev/null && return 0
  cp "$src" "$dest"
}

session_pane_count() {
  local session="$1"
  tmux list-panes -s -t "$session" 2>/dev/null | wc -l | tr -d ' '
}

session_window_count() {
  local session="$1"
  tmux list-windows -t "$session" 2>/dev/null | wc -l | tr -d ' '
}

session_created_value() {
  local session="$1"
  local epoch
  epoch="$(tmux display-message -p -t "$session" '#{session_created}' 2>/dev/null || true)"
  [[ -n "$epoch" ]] && date -r "$epoch" '+%Y-%m-%d %H:%M:%S' 2>/dev/null || true
}

session_attached_value() {
  local session="$1"
  tmux display-message -p -t "$session" '#{session_attached}' 2>/dev/null || true
}

session_workspace_value() {
  local session="$1"
  tmux show-environment -t "$session" AGENT_WINDOW_WORKSPACE 2>/dev/null | sed 's/^[^=]*=//' || true
}

load_session_runtime_context() {
  local session="$1" env_output parsed key value
  env_output="$(tmux show-environment -t "$session" 2>/dev/null || true)"
  parsed="$(python3 - "$REPO_ROOT" "$env_output" <<'PYEOF'
import sys
from pathlib import Path

repo_root = Path(sys.argv[1]).resolve()
env_output = sys.argv[2]
sys.path.insert(0, str(repo_root / "bin"))
from agent_window_lib.session import session_context_from_env_output

context = session_context_from_env_output(env_output)
print(f"WORKSPACE={context.get('workspace', '')}")
print(f"TMUX_SOCKET={context.get('tmux_socket', '')}")
PYEOF
  )"

  session_workspace=""
  session_socket=""
  session_log_dir=""
  while IFS='=' read -r key value; do
    case "$key" in
      WORKSPACE) session_workspace="$value" ;;
      TMUX_SOCKET) session_socket="$value" ;;
    esac
  done <<< "$parsed"

  [[ -n "$session_workspace" ]] && WORKSPACE="$session_workspace"
  [[ -n "$session_socket" ]] && TMUX_SOCKET_NAME="$session_socket"
}

primary_agent_pane_id() {
  local session="$1"
  local agents_str instance upper pane_id
  agents_str="$(session_agents_value "$session")"
  [[ "$agents_str" == "-" ]] && return 0
  IFS=',' read -ra _agent_instances <<< "$agents_str"
  for instance in "${_agent_instances[@]}"; do
    [[ -n "$instance" ]] || continue
    upper="$(printf '%s' "$instance" | tr '[:lower:]-' '[:upper:]_')"
    pane_id="$(tmux show-environment -t "$session" "AGENT_WINDOW_PANE_${upper}" 2>/dev/null | sed 's/^[^=]*=//' || true)"
    [[ -n "$pane_id" ]] && { printf '%s\n' "$pane_id"; return 0; }
  done
  return 0
}

window_target_for_pane() {
  local pane_id="$1"
  python3 - "$REPO_ROOT" "$pane_id" "$TMUX_SOCKET_NAME" <<'PYEOF'
import sys
from pathlib import Path

repo_root = Path(sys.argv[1]).resolve()
pane_id = sys.argv[2]
tmux_socket = sys.argv[3]
sys.path.insert(0, str(repo_root))
from backend_core.tmux.window import window_target_for_pane

print(window_target_for_pane(pane_id=pane_id, tmux_socket=tmux_socket))
PYEOF
}

