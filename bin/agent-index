#!/usr/bin/env bash
set -euo pipefail

_HERE="$(python3 -c 'import os, sys; print(os.path.realpath(sys.argv[1]))' "${BASH_SOURCE[0]:-$0}")"
_BIN="$(cd "$(dirname "$_HERE")" && pwd)"
REPO_ROOT="$(cd "$_BIN/.." && pwd)"

HUB_LIB_DIR="$_BIN/hub_lib"
# shellcheck source=/dev/null
source "$HUB_LIB_DIR/bootstrap.sh"
# shellcheck source=/dev/null
source "$HUB_LIB_DIR/network.sh"

HUB_PORT="$(cat "$REPO_ROOT/hub-port")"
READY_TIMEOUT_SEC=6

while [[ $# -gt 0 ]]; do
  case "$1" in
    -h|--help) usage; exit 0 ;;
    *) echo "Unknown argument: $1" >&2; usage >&2; exit 1 ;;
  esac
done

LAN_HTTPS_ENABLED_FILE="${AGENT_WINDOW_STATE_DIR:-$HOME/.agent-window/state}/access/lan-https-enabled"
if [[ -f "$LAN_HTTPS_ENABLED_FILE" ]]; then
  CERTS_DIR="${AGENT_WINDOW_CERTS_DIR:-$HOME/.agent-window/state/certs}"
  : "${AGENT_WINDOW_CERT_FILE:=$CERTS_DIR/cert.pem}"
  : "${AGENT_WINDOW_KEY_FILE:=$CERTS_DIR/key.pem}"
  export AGENT_WINDOW_CERT_FILE AGENT_WINDOW_KEY_FILE
  if [[ ! -f "${AGENT_WINDOW_CERT_FILE}" || ! -f "${AGENT_WINDOW_KEY_FILE}" ]]; then
    echo "LAN HTTPS is enabled; certificate files are missing." >&2
    exit 1
  fi
  LOCAL_SCHEME="https"
else
  unset AGENT_WINDOW_CERT_FILE AGENT_WINDOW_KEY_FILE
  LOCAL_SCHEME="http"
fi
if [[ "$LOCAL_SCHEME" == "https" ]]; then
  PUBLIC_HOST_FILE="${AGENT_WINDOW_CERTS_DIR:-$HOME/.agent-window/state/certs}/public-host.txt"
  if [[ -z "${AGENT_WINDOW_PUBLIC_HOST:-}" ]] && [[ -f "$PUBLIC_HOST_FILE" ]]; then
    export AGENT_WINDOW_PUBLIC_HOST="$(tr -d '\r\n' < "$PUBLIC_HOST_FILE")"
  fi
  if [[ -z "${AGENT_WINDOW_PUBLIC_HUB_PORT:-}" ]]; then
    export AGENT_WINDOW_PUBLIC_HUB_PORT="443"
  fi
else
  unset AGENT_WINDOW_PUBLIC_HOST AGENT_WINDOW_PUBLIC_HUB_PORT
fi
if ! port_serves_expected_url "$LOCAL_SCHEME" "$HUB_PORT" "/hub.webmanifest"; then
  if ! command -v lsof >/dev/null 2>&1; then
    echo "lsof is required to inspect port $HUB_PORT." >&2
    exit 1
  fi
  if port_has_listener "$HUB_PORT"; then
    echo "Hub port $HUB_PORT is occupied by a listener that does not serve the expected ${LOCAL_SCHEME} Hub." >&2
    exit 1
  fi
  PYTHONPATH="$HUB_PYTHONPATH" nohup python3 -m hub_backend.hub_server "$REPO_ROOT" "$SCRIPT_DIR/agent-index" "$TMUX_SOCKET_NAME" >/dev/null 2>&1 </dev/null &
  HUB_SERVER_PID=$!
  disown "$HUB_SERVER_PID" || true
  if ! wait_for_expected_url "$LOCAL_SCHEME" "$HUB_PORT" "/hub.webmanifest" "$READY_TIMEOUT_SEC"; then
    echo "Hub server failed to start on ${LOCAL_SCHEME}://127.0.0.1:${HUB_PORT}/." >&2
    exit 1
  fi
fi

HUB_URL="${LOCAL_SCHEME}://127.0.0.1:${HUB_PORT}/"

echo "Hub:                $HUB_URL"
if [[ "$LOCAL_SCHEME" == "https" ]]; then
  LOCAL_IP="$(detect_local_ip || true)"
  if [[ -n "$LOCAL_IP" ]]; then
    echo "Hub (LAN / phone): ${LOCAL_SCHEME}://${LOCAL_IP}:${HUB_PORT}/"
  else
    echo "Tip (phone): open Hub using this Mac's LAN hostname instead of 127.0.0.1 (same Wi‑Fi)."
  fi
  echo "From Hub: New Session, Resume, Settings, ... — see README if HTTPS warns on iPhone."
else
  echo "Hub is loopback-only. See README to enable LAN HTTPS for phone access."
fi
