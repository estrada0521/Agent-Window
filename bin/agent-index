#!/usr/bin/env bash
set -euo pipefail

_HERE="$(python3 -c 'import os, sys; print(os.path.realpath(sys.argv[1]))' "${BASH_SOURCE[0]:-$0}")"
_BIN="$(cd "$(dirname "$_HERE")" && pwd)"
REPO_ROOT="$(cd "$_BIN/.." && pwd)"

HUB_LIB_DIR="$_BIN/hub_lib"
# shellcheck source=/dev/null
source "$HUB_LIB_DIR/bootstrap.sh"
# shellcheck source=/dev/null
source "$HUB_LIB_DIR/network.sh"

HUB_PORT="$(cat "$REPO_ROOT/hub-port")"
READY_TIMEOUT_SEC=6

while [[ $# -gt 0 ]]; do
  case "$1" in
    -h|--help) usage; exit 0 ;;
    *) echo "Unknown argument: $1" >&2; usage >&2; exit 1 ;;
  esac
done

if ! hub_is_up; then
  if ! command -v lsof >/dev/null 2>&1; then
    echo "lsof is required to inspect port $HUB_PORT." >&2
    exit 1
  fi
  if port_has_listener "$HUB_PORT"; then
    echo "Hub port $HUB_PORT is occupied by a listener that does not serve the expected Hub." >&2
    exit 1
  fi
  PYTHONPATH="$HUB_PYTHONPATH" nohup python3 -m hub_backend.hub_server "$REPO_ROOT" "$SCRIPT_DIR/agent-index" >/dev/null 2>&1 </dev/null &
  HUB_SERVER_PID=$!
  disown "$HUB_SERVER_PID" || true
  if ! hub_is_up "$READY_TIMEOUT_SEC"; then
    echo "Hub server failed to start on http://127.0.0.1:${HUB_PORT}/." >&2
    exit 1
  fi
fi

HUB_URL="http://127.0.0.1:${HUB_PORT}/"

echo "Hub:                $HUB_URL"
