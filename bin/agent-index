#!/usr/bin/env bash
set -euo pipefail

_HERE="$(python3 -c 'import os, sys; print(os.path.realpath(sys.argv[1]))' "${BASH_SOURCE[0]:-$0}")"
_BIN="$(cd "$(dirname "$_HERE")" && pwd)"
REPO_ROOT="$(cd "$_BIN/.." && pwd)"

HUB_LIB_DIR="$_BIN/hub_lib"
# shellcheck source=/dev/null
source "$HUB_LIB_DIR/bootstrap.sh"
# shellcheck source=/dev/null
source "$HUB_LIB_DIR/https.sh"
# shellcheck source=/dev/null
source "$HUB_LIB_DIR/session.sh"

SESSION_NAME=""
CHAT_MODE=0
HUB_MODE=0
HTTPS_MODE=0
HTTPS_MODE_EXPLICIT=0
HUB_PORT="${AGENT_INDEX_HUB_PORT:-8788}"
SESSION_IS_ACTIVE=0
READY_TIMEOUT_SEC=6

while [[ $# -gt 0 ]]; do
  case "$1" in
    --session) SESSION_NAME="$2"; shift 2 ;;
    --chat) CHAT_MODE=1; shift ;;
    --hub) HUB_MODE=1; shift ;;
    --hub-port) HUB_PORT="$2"; shift 2 ;;
    --https) HTTPS_MODE=1; HTTPS_MODE_EXPLICIT=1; shift ;;
    --http) HTTPS_MODE=0; HTTPS_MODE_EXPLICIT=1; shift ;;
    -h|--help) usage; exit 0 ;;
    *) echo "Unknown argument: $1" >&2; usage >&2; exit 1 ;;
  esac
done

PWA_ENABLED_FILE="${AGENT_WINDOW_STATE_DIR:-$HOME/.agent-window/state}/pwa/enabled"
if [[ "$HTTPS_MODE_EXPLICIT" -eq 0 && ( "${AGENT_WINDOW_ENABLE_LOCAL_HTTPS:-}" == "1" || -f "$PWA_ENABLED_FILE" ) ]]; then
  HTTPS_MODE=1
fi
if [[ "$HTTPS_MODE" -eq 1 ]]; then
  if [[ ! -f "$PWA_ENABLED_FILE" ]]; then
    echo "PWA HTTPS is not enabled yet." >&2
    echo "Start the HTTP Tauri app first, then run ./setup/pwa/enable." >&2
    exit 1
  fi
  export AGENT_WINDOW_ENABLE_LOCAL_HTTPS=1
  CERTS_DIR="${AGENT_WINDOW_CERTS_DIR:-$HOME/.agent-window/state/certs}"
  : "${AGENT_WINDOW_CERT_FILE:=$CERTS_DIR/cert.pem}"
  : "${AGENT_WINDOW_KEY_FILE:=$CERTS_DIR/key.pem}"
  export AGENT_WINDOW_CERT_FILE AGENT_WINDOW_KEY_FILE
  if [[ ! -f "${AGENT_WINDOW_CERT_FILE}" || ! -f "${AGENT_WINDOW_KEY_FILE}" ]]; then
    echo "PWA is enabled; HTTPS certificate files are missing." >&2
    exit 1
  fi
  HTTPS_SCHEME="https"
else
  if [[ -f "$PWA_ENABLED_FILE" ]]; then
    echo "PWA is enabled; HTTP is not allowed." >&2
    exit 1
  fi
  unset AGENT_WINDOW_CERT_FILE AGENT_WINDOW_KEY_FILE AGENT_WINDOW_ENABLE_LOCAL_HTTPS
  HTTPS_SCHEME="http"
fi
if [[ "$HTTPS_SCHEME" == "https" ]]; then
  PUBLIC_HOST_FILE="${AGENT_WINDOW_CERTS_DIR:-$HOME/.agent-window/state/certs}/public-host.txt"
  if [[ -z "${AGENT_WINDOW_PUBLIC_HOST:-}" ]] && [[ -f "$PUBLIC_HOST_FILE" ]]; then
    export AGENT_WINDOW_PUBLIC_HOST="$(tr -d '\r\n' < "$PUBLIC_HOST_FILE")"
  fi
  if [[ -z "${AGENT_WINDOW_PUBLIC_HUB_PORT:-}" ]]; then
    export AGENT_WINDOW_PUBLIC_HUB_PORT="443"
  fi
else
  unset AGENT_WINDOW_PUBLIC_HOST AGENT_WINDOW_PUBLIC_HUB_PORT
fi
if [[ "$HUB_MODE" -eq 1 ]]; then
  if ! port_serves_expected_url "$HTTPS_SCHEME" "$HUB_PORT" "/hub.webmanifest"; then
    STALE_HUB_PIDS="$(list_listening_pids "$HUB_PORT")"
    if [[ -n "${STALE_HUB_PIDS//[[:space:]]/}" ]]; then
      echo "Hub port $HUB_PORT is occupied by a listener that is not ${HTTPS_SCHEME}." >&2
      exit 1
    fi
    PYTHONPATH="$HUB_PYTHONPATH" AGENT_WINDOW_AGENT_NAME="user" nohup python3 -m hub_backend.hub_server "$REPO_ROOT" "$SCRIPT_DIR/agent-index" "$HUB_PORT" "$TMUX_SOCKET_NAME" >/dev/null 2>&1 </dev/null &
    HUB_SERVER_PID=$!
    disown "$HUB_SERVER_PID" || true
    if ! wait_for_expected_url "$HTTPS_SCHEME" "$HUB_PORT" "/hub.webmanifest" "$READY_TIMEOUT_SEC"; then
      echo "Hub server failed to start on ${HTTPS_SCHEME}://127.0.0.1:${HUB_PORT}/." >&2
      exit 1
    fi
  fi

  HUB_URL="${HTTPS_SCHEME}://127.0.0.1:${HUB_PORT}/"
  LOCAL_IP="$(detect_local_ip || true)"

  echo "Hub:                $HUB_URL"
  if [[ -n "$LOCAL_IP" ]]; then
    echo "Hub (LAN / phone): ${HTTPS_SCHEME}://${LOCAL_IP}:${HUB_PORT}/"
  else
    echo "Tip (phone): open Hub using this Mac's LAN IP instead of 127.0.0.1 (same Wi‑Fi)."
  fi
  if [[ "$HTTPS_SCHEME" == "https" ]]; then
    echo "From Hub: New Session, Resume, Settings, ... — see README if HTTPS warns on iPhone."
  else
    echo "From Hub: New Session, Resume, Settings, ..."
  fi
  exit 0
fi

SESSION_NAME="$(resolve_session_name)" || exit 1
# The log folder is this session's only real identity; tmux is asked (via
# session_control, which resolves by workspace, never by name-matching)
# only to learn whether it's currently active.
SESSION_STATUS_JSON="$(session_control describe --session "$SESSION_NAME" --json)" || exit 1
SESSION_IS_ACTIVE="$(session_json_field "$SESSION_STATUS_JSON" active)"
SESSION_WORKSPACE="$(session_json_field "$SESSION_STATUS_JSON" workspace)"
if [[ -z "$SESSION_WORKSPACE" ]]; then
  echo "workspace unavailable for session: $SESSION_NAME" >&2
  exit 1
fi
SESSION_LOG_DIR="$(resolve_session_log_dir)"
INDEX_FILE="${SESSION_LOG_DIR}/.log.jsonl"

if [[ ! -f "$INDEX_FILE" && "$CHAT_MODE" -ne 1 ]]; then
  echo "No indexed messages found for session: $SESSION_NAME"
  exit 0
fi

if [[ "$CHAT_MODE" -eq 1 ]]; then
  CHAT_PORT="$(PYTHONPATH="$HUB_PYTHONPATH" python3 -m server.port_cli "$SESSION_NAME")"
  CHAT_ALREADY_UP=0
  if [[ "${AGENT_WINDOW_CHAT_RESTART_HANDOFF:-}" != "1" ]] \
    && port_serves_expected_url "$HTTPS_SCHEME" "$CHAT_PORT" "/app.webmanifest"; then
    CHAT_ALREADY_UP=1
  fi
  if [[ "$CHAT_ALREADY_UP" -ne 1 ]]; then
    STALE_CHAT_PIDS="$(list_listening_pids "$CHAT_PORT")"
    if [[ -n "${STALE_CHAT_PIDS//[[:space:]]/}" ]]; then
      echo "Chat port $CHAT_PORT is occupied by a listener that is not ${HTTPS_SCHEME}." >&2
      exit 1
    fi
    SESSION_IS_ACTIVE="$SESSION_IS_ACTIVE" \
      PYTHONPATH="$HUB_PYTHONPATH" \
      AGENT_WINDOW_AGENT_NAME="user" \
      AGENT_INDEX_HUB_PORT="$HUB_PORT" \
      AGENT_WINDOW_TMUX_SOCKET="$TMUX_SOCKET_NAME" \
      nohup python3 -m server.server "$SESSION_NAME" "$SESSION_WORKSPACE" >/dev/null 2>&1 </dev/null &
    CHAT_SERVER_PID=$!
    disown "$CHAT_SERVER_PID" || true
    if ! wait_for_expected_url "$HTTPS_SCHEME" "$CHAT_PORT" "/app.webmanifest" "$READY_TIMEOUT_SEC"; then
      echo "Chat server failed to start on ${HTTPS_SCHEME}://127.0.0.1:${CHAT_PORT}/." >&2
      exit 1
    fi
  fi
  CHAT_URL="${HTTPS_SCHEME}://127.0.0.1:${CHAT_PORT}/"
  LOCAL_IP="$(detect_local_ip || true)"

  echo "Opened chat view: $CHAT_URL"
  if [[ -n "$LOCAL_IP" ]]; then
    echo "Network access:   ${HTTPS_SCHEME}://${LOCAL_IP}:${CHAT_PORT}/"
  fi
  echo "Log file:         $INDEX_FILE"
  exit 0
fi
