#!/usr/bin/env bash
set -euo pipefail

mkcert_cmd() {
  if command -v mkcert >/dev/null 2>&1; then
    command -v mkcert
    return 0
  fi
  if [[ -x /opt/homebrew/bin/mkcert ]]; then
    printf '%s\n' /opt/homebrew/bin/mkcert
    return 0
  fi
  if [[ -x /usr/local/bin/mkcert ]]; then
    printf '%s\n' /usr/local/bin/mkcert
    return 0
  fi
  return 1
}

show_ios_trust_help() {
  local mkcert_bin="$1"
  local caroot="" root_ca=""
  caroot="$("$mkcert_bin" -CAROOT 2>/dev/null || true)"
  if [[ -n "$caroot" ]]; then
    root_ca="${caroot}/rootCA.pem"
  fi
  echo >&2
  echo "agent-window: local HTTPS is ready on this Mac." >&2
  echo "agent-window: iPhone / iPad で LAN HTTPS を使う場合は、次の手順が追加で必要です。" >&2
  if [[ -n "$root_ca" ]]; then
    echo "agent-window: 1. ${root_ca} を AirDrop / Files / Mail などで端末へ送る" >&2
  else
    echo "agent-window: 1. mkcert の rootCA.pem を端末へ送る" >&2
  fi
  echo "agent-window: 2. 端末で証明書プロファイルをインストールする" >&2
  echo "agent-window: 3. Settings > General > About > Certificate Trust Settings で trust を有効化する" >&2
  echo "agent-window: rootCA-key.pem は絶対に共有しないでください。" >&2
  echo >&2
}

reveal_root_ca_in_finder() {
  local mkcert_bin="$1"
  local caroot="" root_ca=""
  [[ "$(uname -s 2>/dev/null || true)" == "Darwin" ]] || return 0
  command -v open >/dev/null 2>&1 || return 0
  caroot="$("$mkcert_bin" -CAROOT 2>/dev/null || true)"
  [[ -n "$caroot" ]] || return 0
  root_ca="${caroot}/rootCA.pem"
  [[ -f "$root_ca" ]] || return 0
  echo "agent-window: revealing rootCA.pem in Finder..." >&2
  open -R "$root_ca" >/dev/null 2>&1 || true
}

emit_mode() {
  printf '%s\n' "$1"
}

announce_local_https_requirement() {
  cat >&2 <<'EOF'
agent-window: phone/PWA access requires local HTTPS.
agent-window: mkcert を使って localhost / LAN 向け証明書を用意します。
agent-window: - Home Screen web app
agent-window: - secure browser APIs (camera, clipboard, etc.)
agent-window: - 将来の service worker / push 系機能
EOF
}

main() {
  local mkcert_bin=""
  announce_local_https_requirement

  if mkcert_bin="$(mkcert_cmd 2>/dev/null)"; then
    echo "agent-window: using existing mkcert for local HTTPS." >&2
  else
    echo "agent-window: mkcert is required. Nothing was installed." >&2
    echo "agent-window: install it yourself with: brew install mkcert" >&2
    exit 1
  fi
  echo "agent-window: installing local CA into the system trust store..." >&2
  "$mkcert_bin" -install >&2
  reveal_root_ca_in_finder "$mkcert_bin"
  show_ios_trust_help "$mkcert_bin"
  emit_mode enabled
}

main "$@"
